---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
---

<Layout
  title="Página não encontrada"
  description="A página que você procura não existe."
  overlap={true}
>
  <Section paddingTop="navoverlap" paddingBottom="navoverlap" class="flex-grow">
    <ContentWrapper centered={true}>
      <Heading variant="h3" tag="h1" maxWidth={17}
        >Esta página não existe</Heading
      >
      <Paragraph variant="large" maxWidth={36}
        >A página que você procura pode ter mudado de endereço, ou o link que
        trouxe você até aqui está desatualizado.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href="/">Voltar para o início</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
