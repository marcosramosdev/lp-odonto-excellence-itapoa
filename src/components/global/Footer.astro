---
import Img from '@/components/media/Img.astro';
import logo from '@/assets/logo/logo-odonto-excellence.png';
import { SITE_NAME } from '@/consts.ts';

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_top">
          <a class="footer_logo" href="/#">
            <Img
              src={logo}
              alt={SITE_NAME}
              variant="densities"
              width={120}
              transparent={true}
            />
          </a>
          <div class="footer_info text-style-small">
            <p>Unidade franqueada da rede Odonto Excellence.</p>
            <address class="footer_address">
              <p>Av. Celso Ramos, 512 — Cambijú, Itapoá - SC, CEP 89249-000</p>
              <p>
                WhatsApp:{' '}
                <a
                  href="https://wa.me/5547997660991"
                  target="_blank"
                  rel="noopener"
                >
                  (47) 99766-0991
                </a>{' '}
                · Instagram:{' '}
                <a
                  href="https://www.instagram.com/odontoexcellence_itapoa/"
                  target="_blank"
                  rel="noopener"
                >
                  @odontoexcellence_itapoa
                </a>
              </p>
            </address>
          </div>
        </div>
        <div class="footer_bottom text-style-small">
          <p>
            Responsável técnico: Dr. Renato Gonzales de Souza Forti — CRO-SC
            22.911 · EPAO-SC 1.579
          </p>
          <p>
            &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
            {SITE_NAME}
          </p>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>('#year');

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-block: var(--section-space-small);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-6);
    }

    .footer_logo {
      display: block;
      mix-blend-mode: multiply;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_info {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      max-width: 36ch;
      color: var(--text-2);
    }

    .footer_address {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-style: normal;
    }

    .footer_bottom {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--border);
      color: var(--text-2);
    }
  }
</style>
