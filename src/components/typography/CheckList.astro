---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import check from "@/assets/icons/check.svg";

type Props = HTMLAttributes<"ul"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** List items. Omit or leave empty to render nothing. */
  items?: string[];
};

const { render = true, items = [], class: className, ...rest } = Astro.props;
---

{
  render && items.length > 0 && (
    <ul class:list={["check-list_wrap", className]} {...rest}>
      {items.map((item) => (
        <li class="check-list_item">
          <span class="check-list_mark" aria-hidden="true">
            <Icon src={check} variant="small" />
          </span>
          {item}
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    .check-list_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .check-list_item {
      display: flex;
      align-items: start;
      gap: var(--space-2);
    }

    .check-list_mark {
      flex: none;
      display: flex;
      align-items: center;
      height: 1lh;
      color: var(--heading-accent);
    }
  }
</style>
